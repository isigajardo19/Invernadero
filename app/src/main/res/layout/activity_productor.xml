<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Panel del productor"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTemperatura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="-- °C"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAlerta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Conectando..."
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVentilacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ventilación: --"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvRiego"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Riego: --"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvModo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Modo: --" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Umbral de temperatura (°C)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUmbral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 30"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/btnGuardarUmbral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Guardar umbral" />

        <Button
            android:id="@+id/btnModo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Cambiar modo (automático / manual)" />

        <Button
            android:id="@+id/btnVentilacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Encender / apagar ventilación" />

        <Button
            android:id="@+id/btnRiego"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Encender / apagar riego" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Historial (últimas lecturas)"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHistorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sin lecturas todavía" />

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Volver al menú" />

    </LinearLayout>
</ScrollView>